# Telegram API credentials from https://my.telegram.org/apps
API_ID=123456
API_HASH=replace_me

# Recommended for Docker/Incus. Generate with:
# python -m scripts.generate_session
SESSION_STRING=
SESSION_NAME=hohokhan

# Your Telegram numeric ID. Privileged commands are limited to this account.
OWNER_ID=123456789

# Optional comma-separated trusted user IDs for privileged commands.
SUDO_USER_IDS=

# Optional features
OPENWEATHER_API_KEY=
MEDIA_ARCHIVE_CHAT_ID=
# Optional Netscape cookies.txt for YouTube. Store it under ./data with mode 600.
# Direct install: ./data/youtube-cookies.txt
# Docker/Incus:   /app/data/youtube-cookies.txt
YTDLP_COOKIES_FILE=

# Runtime limits
DATA_DIR=./data
TEMP_DIR=/tmp/hohokhan
MAX_DOWNLOAD_MB=150
MAX_MEDIA_DURATION_SECONDS=1800
# Random yt-dlp delay is this value through this value + 5 seconds. Use 0 to disable.
YTDLP_SLEEP_INTERVAL_SECONDS=5
DOWNLOAD_CONCURRENCY=2
RATE_LIMIT_MESSAGES=8
RATE_LIMIT_WINDOW_SECONDS=3
RATE_LIMIT_PENALTY_SECONDS=300
LOG_LEVEL=INFO
